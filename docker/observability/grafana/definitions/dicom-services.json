{
  "uid": "dicom-services",
  "title": "DICOM services",
  "tags": [
    "dicom"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape availability",
      "type": "timeseries",
      "description": "1: endpoint доступен, 0: scrape завершился ошибкой. Отсутствие ряда означает отсутствие данных от Collector.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{group=\"dicom\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Go goroutines",
      "type": "timeseries",
      "description": "Число goroutine в каждом процессе.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{group=\"dicom\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Resident memory",
      "type": "timeseries",
      "description": "Память процесса; process-метрики доступны в Linux-контейнерах.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{group=\"dicom\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU usage",
      "type": "timeseries",
      "description": "Потребление CPU процессом.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{group=\"dicom\",service=~\"$service\"}[$__rate_interval])",
          "legendFormat": "{{service}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Operation counters / second",
      "type": "timeseries",
      "description": "Отдельные счётчики разных слоёв приложения; их нельзя складывать в общее число запросов. Появляются после первого вызова.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate({group=\"dicom\",service=~\"$service\",__name__=~\"dicom[-_].*\",__name__!~\".*(duration_seconds.*|active|connected|ready|timestamp_seconds|created)\"}[$__rate_interval])",
          "legendFormat": "{{service}} / {{__name__}} / {{operation}} / {{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Errors / second",
      "type": "timeseries",
      "description": "Счётчики ошибок появляются только после соответствующей ошибки. Пустая панель сама по себе не означает сбой сбора.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate({group=\"dicom\",service=~\"$service\",__name__=~\"dicom[-_].*[_.]?error(_total)?\"}[$__rate_interval])",
          "legendFormat": "{{service}} / {{__name__}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(dicom_analyzer_messaging_total{group=\"dicom\",service=~\"$service\",outcome=\"error\"}[$__rate_interval])",
          "legendFormat": "{{service}} / {{operation}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Last operation duration",
      "type": "timeseries",
      "description": "Gauge последнего вызова, а не средняя длительность или перцентиль.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{group=\"dicom\",service=~\"$service\",__name__=~\"dicom[-_].*[_.]duration_seconds\"}",
          "legendFormat": "{{service}} / {{__name__}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Outbox dispatcher active",
      "type": "timeseries",
      "description": "1: dispatcher запущен. При выборе только manager данных здесь нет.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{group=\"dicom\",service=~\"$service\",__name__=~\"dicom[-_].*[_.]outbox[_.]dispatcher[_.]active\"}",
          "legendFormat": "{{service}}",
          "range": true
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(up{group=\"dicom\"}, service)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
