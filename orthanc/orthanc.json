{
  "AwsS3Storage": {
    "BucketName": "test",
    "Region": "eu-west-1",
    "Endpoint": "http://raw-dicom:9000/",
    "AccessKey": "${S3_USER}",
    "SecretKey": "${S3_PASSWORD}",
    "VirtualAddressing": false
  },
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": true,
  "RegisteredUsers": {
    "dicom-orthanc": "${ORTHANC_PASSWORD}",
    "dicom-manager": "${ORTHANC_PASSWORD}"
  },
  "Autoroute": {
    "ManagerUrl": "${ORTHANC_AUTOROUTE_MANAGER_URL}",
    "Email": "${ORTHANC_AUTOROUTE_EMAIL}",
    "Password": "${ORTHANC_AUTOROUTE_PASSWORD}"
  },
  "LuaScripts": [
    "/etc/orthanc/autoroute.lua"
  ],
  "DefaultEncoding" : "Utf8"
}
